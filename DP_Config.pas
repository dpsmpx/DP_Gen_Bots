{
  Параметры модели. Всё, что имеет смысл крутить в экспериментах, собрано
  здесь и только здесь: остальные модули не содержат числовых литералов.
}
unit DP_Config;

const
  // ---------- популяция ----------
  ///Размер популяции
  MAXIMUM_BOTS          = 128;
  ///Сколько лучших геномов переносится в новое поколение без изменений
  ELITE_BOT_COUNT       = 12;

  // ---------- геном ----------
  ///Длина генома. Ген хранит значение 0..GENOME_LENGTH-1 и служит
  ///одновременно кодом команды (по остатку от COMMAND_COUNT) и смещением
  ///относительного перехода, поэтому мутация гена осмысленна в обеих ролях.
  GENOME_LENGTH         = 64;
  ///Сколько различных команд понимает бот
  COMMAND_COUNT         = 6;
  ///Сколько ситуаций различает сенсор; столько же генов подряд после
  ///команды сенсора образуют таблицу переходов
  SENSOR_SITUATIONS     = 6;
  ///Сколько команд бот успевает выполнить за один такт симуляции
  MAXIMUM_THINK_TIME    = 8;
  ///Лимит действий на жизнь бота
  MAXIMUM_ACTIONS       = 500;

  // ---------- поле ----------
  FIELD_WIDTH           = 30;
  FIELD_HEIGHT          = 30;
  PIXEL_SIZE            = 15;
  WINDOW_WIDTH          = FIELD_WIDTH * PIXEL_SIZE;
  WINDOW_HEIGHT         = FIELD_HEIGHT * PIXEL_SIZE;

  // ---------- содержимое поля ----------
  ///Начальное и максимальное число яблок
  INITIAL_APPLES        = 30;
  ///Ниже этого числа яблоко добавляется принудительно
  MINIMUM_APPLES        = 5;
  ///Сколько клеток яда раскладывается на поле
  POISON_COUNT          = 10;
  ///Начальное число стен внутри границы
  INITIAL_WALLS         = 270;
  ///Предел усложнения среды
  MAXIMUM_WALLS         = 360;
  ///Вероятность того, что яблоко за такт превратится в яд
  APPLE_DECAY_PROBABILITY = 0.001;

  // ---------- приспособленность ----------
  ///Награда за съеденное яблоко
  FITNESS_APPLE         = 6;
  ///Награда за уничтожение яда перед собой
  FITNESS_KILL_POISON   = 3;
  ///Награда за первое посещение клетки
  FITNESS_NEW_CELL      = 1;

  // ---------- адаптация ----------
  ///Базовая вероятность мутации гена
  BASE_MUTATION_RATE    = 0.03;
  ///Потолок вероятности мутации при затяжной стагнации
  MAXIMUM_MUTATION_RATE = 0.10;
  ///Сколько окон подряд без роста считается стагнацией
  STAGNATION_THRESHOLD  = 3;
  MUTATION_INCREMENT    = 0.01;
  MUTATION_DECREMENT    = 0.005;
  ///Во сколько раз окно должно просесть, чтобы счесть это деградацией,
  ///а не плато: ниже этой доли от предыдущего окна мутация снижается
  DEGRADATION_RATIO     = 0.9;
  ///Порог средней приспособленности, выше которого среда усложняется
  FITNESS_THRESHOLD     = 40;
  ///Как часто пересматриваются мутация и сложность среды, в поколениях
  ENVIRONMENT_ADAPT_INTERVAL = 25;

  // ---------- прогон ----------
  ///Длина истории для графика
  HISTORY_LENGTH        = 100;
  ///Зерно генератора случайных чисел. Фиксировано, чтобы прогоны были
  ///воспроизводимы; поставьте 0, чтобы каждый запуск отличался.
  RANDOM_SEED           = 20240816;
  ///Файл журнала прогона
  LOG_FILE_NAME         = 'gen_bots_log.csv';

begin
end.
